pipeline {
    agent any

    environment {
        SONAR_SCANNER_HOME = tool 'sq1' // Replace with your SonarScanner installation name in Jenkins
        VENV_PATH = './venv' // Path to your virtual environment
    }

    stages {
        stage('Checkout') {
            steps {
                // Check out the repository
                checkout scm
            }
        }

        stage('Setup Environment') {
            steps {
                // Set up Python virtual environment
                sh '''
                    python3 -m venv ${VENV_PATH}
                    source ${VENV_PATH}/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Static Code Analysis') {
            steps {
                // Perform SonarQube analysis
                withSonarQubeEnv('SonarQube') { // Replace 'SonarQube' with your configured server name
                    sh """
                        source ${VENV_PATH}/bin/activate
                        ${SONAR_SCANNER_HOME}/bin/sonar-scanner \
                        -Dsonar.projectKey=Python-StressTest \
                        -Dsonar.sources=. \
                        -Dsonar.python.version=3.x
                    """
                }
            }
        }

        stage('Test') {
            steps {
                // Run Python tests (e.g., with pytest)
                sh '''
                    source ${VENV_PATH}/bin/activate
                    pytest
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed!'
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
